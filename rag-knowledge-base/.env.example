# Local Embedding (sentence-transformers, supports Chinese + English)
# To change model: https://huggingface.co/sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# LLM API (OpenAI-compatible, e.g. DeepSeek / OpenAI / Azure / Ollama)
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=8
SIMILARITY_THRESHOLD=0.55

# Server
HOST=0.0.0.0
PORT=8000
